@model CLDV7112_Project1.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container py-4">

    <div class="page-header">
        <h1>Add Product</h1>
        <p>Store product information in Azure Table Storage.</p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="ProductName"
                           class="form-label">
                        Product Name
                    </label>

                    <input asp-for="ProductName"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label asp-for="Price"
                           class="form-label">
                        Price
                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label asp-for="StockQuantity"
                           class="form-label">
                        Stock Quantity
                    </label>

                    <input asp-for="StockQuantity"
                           type="number"
                           class="form-control"
                           required />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Product
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

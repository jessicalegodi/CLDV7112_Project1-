@model IEnumerable<CLDV7112_Project1.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">

    <div class="page-header d-flex justify-content-between align-items-center">

        <div>
            <h1>Products</h1>
            <p>
                Product information stored in Azure Table Storage.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Product
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Stock</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @product.ProductName
                            </td>

                            <td>
                                R @product.Price.ToString("N2")
                            </td>

                            <td>
                                @product.StockQuantity
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

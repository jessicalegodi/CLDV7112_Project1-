<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - ABC Retail
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand"
           asp-controller="Home"
           asp-action="Index">

            ABC Retail

        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse"
             id="navigation">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Customer"
                       asp-action="Index">

                        Customers

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Product"
                       asp-action="Index">

                        Products

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Blob"
                       asp-action="Index">

                        Images

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Queue"
                       asp-action="Index">

                        Orders

                    </a>

                </li>

                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="File"
                       asp-action="Index">

                        Logs

                    </a>

                </li>

            </ul>

        </div>

    </div>

</nav>

<main>

    @RenderBody()

</main>

<footer class="border-top mt-5 py-3">

    <div class="container text-muted">

        © 2026 ABC Retail - Azure Cloud Storage

    </div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
